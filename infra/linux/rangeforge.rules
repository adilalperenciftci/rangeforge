## RangeForge auditd baseline
## Goal: enough visibility for the SigmaHQ linux/auditd and process_creation
## rules without flooding the log. Keys are what Sigma rules filter on.

-D
-b 8192
-f 1
--backlog_wait_time 60000

## Process execution (Sigma: linux/process_creation)
-a always,exit -F arch=b64 -S execve,execveat -k exec
-a always,exit -F arch=b32 -S execve,execveat -k exec

## Identity and privilege
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k priv_esc
-w /etc/sudoers.d/ -p wa -k priv_esc
-a always,exit -F arch=b64 -S setuid,setgid,setresuid,setresgid -F auid>=1000 -F auid!=unset -k priv_esc

## Persistence locations
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /var/spool/cron/ -p wa -k cron
-w /etc/systemd/system/ -p wa -k systemd
-w /usr/lib/systemd/system/ -p wa -k systemd
-w /etc/init.d/ -p wa -k init
-w /etc/rc.local -p wa -k init
-w /etc/profile -p wa -k shell_profiles
-w /etc/profile.d/ -p wa -k shell_profiles
-w /etc/bash.bashrc -p wa -k shell_profiles
-w /etc/ld.so.preload -p wa -k ld_preload
-w /etc/ld.so.conf -p wa -k ld_preload
-w /etc/ld.so.conf.d/ -p wa -k ld_preload

## SSH
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /root/.ssh/ -p wa -k ssh_keys

## Kernel modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-w /etc/modprobe.d/ -p wa -k modules

## Network configuration and sockets
-w /etc/hosts -p wa -k network_modifications
-w /etc/resolv.conf -p wa -k network_modifications
-w /etc/network/ -p wa -k network_modifications
-w /etc/netplan/ -p wa -k network_modifications
-a always,exit -F arch=b64 -S socket -F a0=2 -F auid>=1000 -F auid!=unset -k network_connect_4
-a always,exit -F arch=b64 -S socket -F a0=10 -F auid>=1000 -F auid!=unset -k network_connect_6

## Audit and log tampering
-w /etc/audit/ -p wa -k auditconfig
-w /var/log/audit/ -p wa -k auditlog
-w /sbin/auditctl -p x -k audittools
-w /var/log/ -p wa -k log_tampering
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F dir=/var/log -k log_tampering

## Reconnaissance tooling
-w /usr/bin/whoami -p x -k recon
-w /usr/bin/id -p x -k recon
-w /etc/issue -p r -k recon
-w /etc/hostname -p r -k recon

## Data and credentials
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k code_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k data_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -k register_injection
-a always,exit -F arch=b64 -S ptrace -k tracing
-w /etc/pam.d/ -p wa -k pam
-w /etc/security/ -p wa -k pam

## Keep the rules locked until reboot
-e 2
